---
import heatPumpDiagram from "../assets/main/heat_pump_explainer_diagram.png";
// import SlideInStyles from '../styles/SlideInStyles.astro';
// import FadeStyles from '../styles/FadeStyles.astro';
---

<!-- <SlideInStyles /> -->
<section
    class="border-t-4 border-[#0a3d85] bg-white px-6 py-14 sm:px-10"
    aria-labelledby="explainer-heading"
>
    <!-- <div
        class="mx-auto grid max-w-7xl gap-6 md:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)] md:items-center"
    > -->
    <div
        class="mx-auto flex max-w-7xl flex-col gap-6 md:items-center lg:grid lg:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)]"
    >
        <!-- Text -->
        <!-- <div class="mb-auto slide slideRight"> -->
        <!-- <div 
          class="mb-auto"
          data-reveal="slide-from-left"
          data-reveal-distance="50px"
          data-reveal-delay="120ms"
          data-reveal-duration="800ms"
          data-reveal-easing="cubic-bezier(0.22, 1, 0.36, 1)"
        > -->
        <div
            class="slideReveal slideFromLeft mb-auto lg:order-1"
            style="--slide-duration: 900ms; --slide-distance: 60px;"
        >
            <div class="">
                <p
                    class="text-sm font-semibold tracking-[0.3em] text-[#0a7cff] uppercase"
                >
                    Fonctionnement
                </p>

                <!-- <h2 class="mt-2 text-3xl font-normal text-slate-900 sm:text-[2rem] 
                fade-text fade-text-auto"> -->
                <h2
                    class="mt-2 text-3xl font-normal text-slate-900 sm:text-[2rem]"
                    data-reveal="fade-up"
                    data-reveal-delay="120ms"
                    data-reveal-duration="800ms"
                >
                    Comment fonctionne une
                    <span class="font-semibold text-[#0a7cff]">
                        pompe à chaleur ?
                    </span>
                </h2>

                <div
                    class="mt-3 h-[0.12rem] w-[40%] rounded-full bg-[var(--color-bright-blue)]"
                    role="presentation"
                >
                </div>
            </div>

            <div
                class="mt-6 text-justify text-lg leading-relaxed text-slate-700"
            >
                <slot name="body">
                    <p>
                        Une pompe à chaleur (PAC) est un système de chauffage et
                        de climatisation qui utilise les énergies renouvelables
                        présentes dans l’air, l’eau ou le sol pour chauffer ou
                        rafraîchir votre logement. Son principe repose sur un
                        cycle thermodynamique qui capte les calories gratuites
                        de l’environnement pour les transformer en chaleur
                        utilisable à l’intérieur de votre habitation. Investir
                        dans une pompe à chaleur, c’est choisir une solution
                        performante, durable et respectueuse de l’environnement
                        pour un logement plus confortable et économique.
                    </p>
                </slot>
            </div>
        </div>

        <!-- <figure 
      class="mx-auto w-full max-w-md rounded-3xl border border-sky-100 bg-sky-50/60 p-4 shadow-lg"
      data-reveal="slide-from-right"
      data-reveal-distance="50px"
      data-reveal-duration="800ms"
      data-reveal-easing="cubic-bezier(0.22, 1, 0.36, 1)"
    > -->
        <figure
            class="slideReveal slideFromRight mx-auto w-full max-w-md rounded-3xl border border-sky-100 bg-sky-50/60 p-4 shadow-lg lg:order-2"
        >
            <img
                src={heatPumpDiagram.src}
                alt="Schéma illustrant le circuit de fonctionnement d’une pompe à chaleur"
                width={heatPumpDiagram.width ?? 480}
                height={heatPumpDiagram.height ?? 320}
                loading="lazy"
                decoding="async"
                class="h-auto w-full rounded-2xl object-contain"
            />
            <figcaption class="mt-3 text-center text-sm text-slate-600">
                Cycle thermodynamique simplifié d’une PAC.
            </figcaption>
        </figure>
    </div>
</section>

