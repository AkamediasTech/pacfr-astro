---
const { eyebrow, title, description, features } = Astro.props;
---

<section
    id="services"
    class="flex flex-col gap-10"
    aria-labelledby="services-heading"
>
    <div class="max-w-2xl">
        {
            eyebrow && (
                <p class="text-sm font-semibold tracking-[0.3em] text-cyan-600 uppercase">
                    {eyebrow}
                </p>
            )
        }
        <h2
            id="services-heading"
            class="mt-2 text-3xl font-bold text-slate-900 md:text-4xl"
        >
            {title}
        </h2>
        {
            description && (
                <p class="mt-3 text-base text-slate-600">{description}</p>
            )
        }
    </div>

    <div class="grid gap-6 md:grid-cols-3">
        {
            features.map((feature, index) => (
                <article
                    class="rounded-2xl border border-slate-200 bg-white p-6 shadow-lg shadow-slate-200/60 transition hover:border-cyan-500/60"
                    data-reveal="fade-up"
                    data-reveal-delay={index ? String(index * 100) : undefined}
                >
                    {feature.icon && (
                        <div class="mb-5 inline-flex h-12 w-12 items-center justify-center rounded-full bg-cyan-100 text-2xl text-cyan-600">
                            {feature.icon}
                        </div>
                    )}
                    <h3 class="text-lg font-semibold text-slate-900">
                        {feature.title}
                    </h3>
                    <p class="mt-3 text-sm leading-6 text-slate-600">
                        {feature.description}
                    </p>
                </article>
            ))
        }
    </div>
</section>
