---
import TvaLogo from "../assets/main/tva.png";
import AnahLogo from "../assets/main/anha.png";
import MaPrimeRenovIcon from "../assets/main/ma_prime_renov_logo.png";
import EcoPretIcon from "../assets/main/taux0.jpg";
import { Image } from "astro:assets";


const badges = [
  { name: 'TVA 5,5 %', file: TvaLogo },
  { name: 'Agence nationale de l’habitat', file: AnahLogo },
  { name: 'MaPrimeRénov’', file: MaPrimeRenovIcon },
  { name: 'Éco-prêt 0 %', file: EcoPretIcon },
];

---

<section class="bg-white w-full">
  <div class="mx-auto flex max-w-4xl flex-nowrap items-center justify-center gap-6 px-6 py-8 sm:gap-10 lg:py-10">
    {badges.map((badge) => (
      <figure class="flex flex-col items-center gap-3 text-center basis-[20%]">
        <span class="flex h-12 w-fit lg:w-36 items-center justify-center rounded-full">
          <Image
            src={badge.file}
            alt={badge.name}
            class="h-14 sm:h-18 lg:h-20  sm:w-auto  object-contain"
            format="webp"
            loading="lazy"
            decoding="async"
          />
        </span>
      </figure>
    ))}
  </div>
</section>