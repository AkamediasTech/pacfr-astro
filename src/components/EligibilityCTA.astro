---
<section class="bg-[#0a3d85] py-10">
  <div class="mx-auto w-full flex max-w-6xl flex-col items-center gap-6  px-6 text-white lg:flex-row sm:justify-center">
    <p class="font-sans text-center text-2xl font-light sm:text-left">
      Êtes-vous éligible ? Découvrez le montant de vos aides !
    </p>
    <button type="button" id="cta-scroll"  class="btn btn-success btn--glow w-full md:w-auto bg-[#0a7cff] rounded-[4px] shadow-none cursor-pointer font-light text-2xl">Simuler mes aides</button>
  </div>
</section>


<script is:inline>
  document.getElementById('cta-scroll')?.addEventListener('click', () => {
    const target = document.getElementById('eligibility-form-wrapper');
    if (!target) return;

    // const extraOffset = 300;
    // const top = target.getBoundingClientRect().top + window.scrollY - extraOffset;
    const top = 0;
    window.scrollTo({ top, behavior: 'smooth' });
  });
</script>