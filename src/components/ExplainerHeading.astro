---

import { cn } from '../utils/cn';

interface ExplainerHeadingProps {
  eyebrow?: string;
  headingId?: string;
  level?: 1 | 2 | 3 | 4 | 5 | 6;
//   showUnderline?: boolean;
  className?: string;
}


const {
  eyebrow,
  headingId = 'explainer-heading',
  level = 2,
//   showUnderline = true,
  className = '',
} = Astro.props as ExplainerHeadingProps;

const clampedLevel = Math.min(6, Math.max(1, level));
const headingTag = `h${clampedLevel}` as const;

// {import.meta.env.DEV && console.log('showUnderline ->', showUnderline);}

const headingClasses = cn(
  'mt-3 text-3xl font-light text-slate-900 sm:text-[2.2rem]',
  className
);


---

<div>
  {eyebrow && (
    <p class="text-sm font-semibold uppercase tracking-[0.3em] text-[#0a3d85]">
      {eyebrow}
    </p>
  )}
  <component
    is={headingTag}
    id={headingId}
    class={headingClasses}
  >
    <slot />
  </component>
  <!-- {
    showUnderline && (
      <div class="mt-4 h-0.5 w-24 bg-[#0a7cff]" role="presentation"></div>
    )
  } -->
</div>
