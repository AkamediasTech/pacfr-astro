---
import { Image } from 'astro:assets';
import auroraCase from '../assets/cases/aurora.svg';
import atlasCase from '../assets/cases/atlas.svg';
import pulseCase from '../assets/cases/pulse.svg';

const caseStudies = [
  {
    title: 'Aurora Finance',
    description: 'Refonte complète de l’environnement produit avec tests utilisateurs et charte vidéo unifiée.',
    impact: 'Augmentation du taux de conversion de 62 % en 8 semaines.',
    image: auroraCase,
    alt: 'Visual storytelling abstrait pour le projet Aurora Finance',
    reveal: 'slide-left',
  },
  {
    title: 'Atlas Mobility',
    description: 'Campagne de lancement omnicanale avec activation social media et mini-site interactif.',
    impact: '3,2 M de vues cumulées et +140 % d’inscriptions newsletter.',
    image: atlasCase,
    alt: 'Illustration gradient pour la campagne Atlas Mobility',
    reveal: 'fade-up',
  },
  {
    title: 'Pulse Health',
    description: 'Plateforme de contenus éducatifs, capsules vidéos et motion design sur mesure.',
    impact: 'Session moyenne x2 et NPS +18 points en 3 mois.',
    image: pulseCase,
    alt: 'Graphiques circulaires futuristes pour Pulse Health',
    reveal: 'slide-right',
  },
];
---
<section id="case-studies" class="flex flex-col gap-10" aria-labelledby="case-heading">
  <div class="max-w-2xl">
    <p class="text-sm font-semibold uppercase tracking-[0.3em] text-cyan-600">Études de cas</p>
    <h2 id="case-heading" class="mt-2 text-3xl font-bold text-slate-900 md:text-4xl">Des lancements qui génèrent de l’impact</h2>
    <p class="mt-3 text-base text-slate-600">
      Chaque mission est conçue avec une équipe dédiée : stratégistes, designers, vidéastes et spécialistes média. Voici trois projets récents où collaboration et créativité ont livré des résultats mesurables.
    </p>
  </div>

  <div class="grid gap-8 lg:grid-cols-3">
    {caseStudies.map((item, index) => (
      <article
        class="reveal rounded-3xl border border-slate-200 bg-white p-6 shadow-xl shadow-slate-200/70 transition hover:border-cyan-500/60"
        data-reveal={item.reveal}
        data-reveal-delay={index ? String(index * 120) : undefined}
      >
        <div class="overflow-hidden rounded-2xl border border-slate-100 bg-slate-100">
          <Image
            src={item.image}
            alt={item.alt}
            widths={[480, 640, 768]}
            sizes="(min-width: 1024px) 30vw, (min-width: 640px) 50vw, 100vw"
            loading="lazy"
            decoding="async"
            class="aspect-[4/3] w-full object-cover"
          />
        </div>
        <div class="mt-6 flex flex-col gap-3">
          <h3 class="text-xl font-semibold text-slate-900">{item.title}</h3>
          <p class="text-sm leading-6 text-slate-600">{item.description}</p>
          <p class="text-sm font-semibold text-cyan-600">{item.impact}</p>
        </div>
      </article>
    ))}
  </div>
</section>
