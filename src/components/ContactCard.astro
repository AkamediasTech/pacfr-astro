---
const { title, description, email } = Astro.props;
const mailtoHref = 'mailto:' + email;
---
<section
  id="contact"
  class="rounded-3xl border border-white/10 bg-white/5 p-8 text-center shadow-lg shadow-cyan-500/10"
  data-reveal="fade-up"
  data-reveal-delay="200"
>
  <h2 class="text-3xl font-semibold text-white">{title}</h2>
  <p class="mt-3 text-base text-white/70">{description}</p>
  <a
    href={mailtoHref}
    class="btn btn-primary btn--glow mt-8"
  >
    {email}
  </a>
</section>