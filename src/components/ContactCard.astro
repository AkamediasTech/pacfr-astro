---
export interface Props {
  title: string;
  description: string;
  email: string;
}

const { title, description, email } = Astro.props;
const mailtoHref = 'mailto:' + email;
---
<section id="contact" class="rounded-3xl border border-white/10 bg-white/5 p-8 text-center shadow-lg shadow-cyan-500/10">
  <h2 class="text-3xl font-semibold text-white">{title}</h2>
  <p class="mt-3 text-base text-white/70">{description}</p>
  <a
    href={mailtoHref}
    class="mt-8 inline-flex items-center justify-center rounded-full bg-cyan-400 px-6 py-3 text-sm font-semibold text-slate-950 transition hover:bg-cyan-300"
  >
    {email}
  </a>
</section>
