---
const { title, description, email } = Astro.props;
const mailtoHref = 'mailto:' + email;
---
<section
  id="contact"
  class="rounded-3xl border border-slate-200 bg-white p-8 text-center shadow-lg shadow-slate-200/70"
  data-reveal="fade-up"
  data-reveal-delay="200"
>
  <h2 class="text-3xl font-semibold text-slate-900">{title}</h2>
  <p class="mt-3 text-base text-slate-600">{description}</p>
  <a
    href={mailtoHref}
    class="btn btn-primary btn--glow mt-8"
  >
    {email}
  </a>
</section>
