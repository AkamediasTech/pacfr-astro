---
import heatPumpExplainerDiagram from '../assets/main/heat_pump_explainer_diagram.png';

type ExplainerImage = {
    src: string;
    alt: string;
    caption?: string;
    width?: number;
    height?: number;
}

interface ExplainerSplitSectionProps {
    eyebrow?: string;
    heading: string;
    highlight?: string;
    body: string;
    image: ExplainerImage;
}

const defaultContent : ExplainerSplitSectionProps = {
  eyebrow: 'Fonctionnement',
  heading: 'Comment fonctionne une pompe à chaleur ?',
  highlight: 'Pompe à chaleur',
  body: `Une pompe à chaleur (PAC) est un système de chauffage et de climatisation qui utilise les énergies renouvelables présentes
  dans l’air, l’eau ou le sol pour chauffer ou rafraîchir votre logement. Son principe repose sur un cycle thermodynamique qui capte
  les calories gratuites de l’environnement pour les transformer en chaleur utilisable à l’intérieur de votre habitation. Investir
  dans une pompe à chaleur, c’est choisir une solution performante, durable et respectueuse de l’environnement pour un logement plus confortable et économique.`,
  image: {
    src: heatPumpExplainerDiagram.src,
    alt: 'Schéma illustrant le circuit de fonctionnement d’une pompe à chaleur',
    caption: 'Cycle thermodynamique simplifié d’une PAC.',
    width: 480,
    height: 320,
  }, 
}

const {
  eyebrow,
  heading,
  highlight,
  body,
  image,
} = { ...defaultContent, ...Astro.props };

const highlightIndex = highlight ? heading.indexOf(highlight) : -1;
const headingParts =
  highlightIndex >= 0
    ? {
        before: heading.slice(0, highlightIndex),
        highlighted: heading.slice(highlightIndex, highlightIndex + highlight.length),
        after: heading.slice(highlightIndex + highlight.length),
      }
    : { before: heading, highlighted: '', after: '' };

---


<section
  class="border-t-4 border-[#0a3d85] bg-white px-6 py-14 sm:px-10"
  aria-labelledby="explainer-heading"
>
  <div class="mx-auto grid max-w-6xl gap-10 md:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)] md:items-center">
    <div>
      {eyebrow && (
        <p class="text-sm font-semibold uppercase tracking-[0.3em] text-[#0a3d85]">
          {eyebrow}
        </p>
      )}
      <h2
        id="explainer-heading"
        class="mt-3 text-3xl font-light text-slate-900 sm:text-[2.2rem]"
      >
        {highlightIndex >= 0 ? (
          <>
            {headingParts.before}
            <span class="font-semibold text-[#0a3d85]">
              {headingParts.highlighted}
            </span>
            {headingParts.after}
          </>
        ) : (
          heading
        )}
      </h2>
      <div class="mt-4 h-0.5 w-24 bg-[#0a7cff]" role="presentation"></div>
      <p class="mt-6 text-lg leading-relaxed text-slate-700">
        {body}
      </p>
    </div>

    <figure class="mx-auto w-full max-w-md rounded-3xl border border-sky-100 bg-sky-50/60 p-4 shadow-lg">
      <img
        src={image.src}
        alt={image.alt}
        width={image.width ?? 480}
        height={image.height ?? 320}
        loading="lazy"
        decoding="async"
        class="h-auto w-full rounded-2xl object-contain"
      />
      {image.caption && (
        <figcaption class="mt-3 text-center text-sm text-slate-600">
          {image.caption}
        </figcaption>
      )}
    </figure>
  </div>
</section>
