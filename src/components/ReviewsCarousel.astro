---

<section class="bg-white">
  <!-- Bandeau titre -->
  <div class="bg-[#1D1F55]">
    <div class="mx-auto max-w-5xl px-6 py-8 text-center text-white sm:py-10">
      <p class="text-xs font-semibold uppercase tracking-[0.4em] text-slate-200">Nos clients</p>
      <h2 class="mt-2 text-2xl font-extrabold sm:text-3xl">
        <span>Parlent de nous</span>
      </h2>
    </div>
  </div>

  <div class="mx-auto max-w-6xl px-6 pb-16 pt-10">
    <!-- Carte résumé -->
    <div class="mb-10 flex flex-col gap-4 rounded-2xl border border-slate-200 bg-white px-6 py-5 shadow-sm sm:flex-row sm:items-center sm:justify-between">
      <div class="flex items-center gap-4">
        <div class="h-14 w-14 overflow-hidden rounded-full bg-slate-200">
          <img src="https://via.placeholder.com/64" alt="EnergieFrance" class="h-full w-full object-cover" />
        </div>
        <div>
          <p class="text-sm font-semibold text-slate-600">EnergieFrance</p>
          <div class="flex items-center gap-2">
            <span class="text-xl font-bold text-slate-900">4.6</span>
            <span class="flex items-center text-amber-400">
              {Array.from({ length: 5 }, (_, index) => (
                <svg
                  class={`h-4 w-4 ${index < 4 ? 'fill-amber-400' : 'fill-slate-200'}`}
                  viewBox="0 0 20 20"
                  aria-hidden="true"
                >
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.12 3.439a1 1 0 00.95.69h3.62c.969 0 1.371 1.24.588 1.81l-2.928 2.128a1 1 0 00-.364 1.118l1.12 3.438c.3.922-.755 1.688-1.54 1.118l-2.928-2.128a1 1 0 00-1.175 0L6.83 16.668c-.784.57-1.838-.196-1.539-1.118l1.12-3.438a1 1 0 00-.364-1.118L3.12 8.866c-.783-.57-.38-1.81.588-1.81h3.62a1 1 0 00.95-.69l1.12-3.439z" />
                </svg>
              ))}
            </span>
          </div>
          <p class="text-xs text-slate-500">Basé sur 39 avis • powered by Google</p>
        </div>
      </div>
      <div class="text-sm text-slate-500">
        <span class="font-semibold text-slate-900">98%</span> de nos clients nous recommandent.
      </div>
    </div>

    <!-- Carousel -->
    <div class="relative" data-carousel>
      <button type="button" class="absolute left-0 top-1/2 hidden -translate-y-1/2 rounded-full bg-white p-2 shadow-md ring-1 ring-slate-200 transition hover:bg-slate-50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-400 sm:flex" data-prev aria-label="Avis précédent">
        <svg class="h-5 w-5 text-slate-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M15 18l-6-6 6-6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </button>

      <div class="overflow-hidden px-1 sm:px-10">
        <ul class="flex transition-transform duration-500 ease-out" data-track style="--slides: 3;">
          {reviews.map((review) => (
            <li class="flex-[0_0_calc(100%/var(--slides))] px-3 py-2" data-slide>
              <article class="h-full rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
                <header class="flex items-start justify-between">
                  <div class="flex items-center gap-3">
                    <span class={`flex h-10 w-10 items-center justify-center rounded-full text-base font-semibold uppercase text-white ${review.avatarColor}`}>
                      {review.avatarInitial}
                    </span>
                    <div>
                      <p class="text-sm font-semibold text-slate-900">{review.name}</p>
                      <p class="text-xs text-slate-500">{review.timeAgo}</p>
                    </div>
                  </div>
                  <span class="text-xs font-semibold uppercase text-slate-400">{review.source}</span>
                </header>

                <div class="mt-4 flex items-center gap-1 text-amber-400">
                  {Array.from({ length: 5 }, (_, index) => (
                    <svg
                      class={`h-4 w-4 ${index < review.rating ? 'fill-amber-400' : 'fill-slate-200'}`}
                      viewBox="0 0 20 20"
                      aria-hidden="true"
                    >
                      <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.12 3.439a1 1 0 00.95.69h3.62c.969 0 1.371 1.24.588 1.81l-2.928 2.128a1 1 0 00-.364 1.118l1.12 3.438c.3.922-.755 1.688-1.54 1.118l-2.928-2.128a1 1 0 00-1.175 0L6.83 16.668c-.784.57-1.838-.196-1.539-1.118l1.12-3.438a1 1 0 00-.364-1.118L3.12 8.866c-.783-.57-.38-1.81.588-1.81h3.62a1 1 0 00.95-.69l1.12-3.439z" />
                    </svg>
                  ))}
                </div>

                <p class="mt-4 text-sm leading-relaxed text-slate-600">{review.text}</p>
              </article>
            </li>
          ))}
        </ul>
      </div>

      <button type="button" class="absolute right-0 top-1/2 hidden -translate-y-1/2 rounded-full bg-white p-2 shadow-md ring-1 ring-slate-200 transition hover:bg-slate-50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-400 sm:flex" data-next aria-label="Avis suivant">
        <svg class="h-5 w-5 text-slate-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M9 18l6-6-6-6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </button>
    </div>

    <div class="mt-6 flex justify-center gap-2" data-dots></div>
  </div>
</section>

<style>
  [data-track] {
    transform: translateX(0);
  }
  [data-dots] button {
    height: 8px;
    width: 8px;
    border-radius: 9999px;
    background-color: #cbd5f5;
    transition: background-color 0.2s ease, transform 0.2s ease;
  }
  [data-dots] button.is-active {
    background-color: #1D1F55;
    transform: scale(1.3);
  }
</style>

<script is:inline>
  const initCarousel = () => {
    const root = document.querySelector('[data-carousel]');
    if (!root) return;

    const track = root.querySelector('[data-track]');
    const slides = Array.from(root.querySelectorAll('[data-slide]'));
    const prev = root.querySelector('[data-prev]');
    const next = root.querySelector('[data-next]');
    const dotsContainer = root.querySelector('[data-dots]');

    let perView = 1;
    let current = 0;
    let dots = [];

    const calcPerView = () => {
      const width = window.innerWidth;
      if (width >= 1024) return 3;
      if (width >= 640) return 2;
      return 1;
    };

    const maxIndex = () => Math.max(0, slides.length - perView);

    const buildDots = () => {
      const totalSteps = Math.max(1, slides.length - perView + 1);
      dotsContainer.innerHTML = '';
      dots = Array.from({ length: totalSteps }, (_, index) => {
        const button = document.createElement('button');
        button.type = 'button';
        button.addEventListener('click', () => {
          current = index;
          render();
        });
        dotsContainer.appendChild(button);
        return button;
      });
    };

    const render = () => {
      current = Math.max(0, Math.min(current, maxIndex()));
      track.style.setProperty('--slides', String(perView));
      const offset = (100 / perView) * current;
      track.style.transform = `translateX(-${offset}%)`;

      dots.forEach((dot, index) => {
        if (index === current) {
          dot.classList.add('is-active');
        } else {
          dot.classList.remove('is-active');
        }
      });
    };

    const updateLayout = () => {
      perView = calcPerView();
      buildDots();
      render();
    };

    prev?.addEventListener('click', () => {
      current = current - 1;
      if (current < 0) current = maxIndex();
      render();
    });

    next?.addEventListener('click', () => {
      current = current + 1;
      if (current > maxIndex()) current = 0;
      render();
    });

    window.addEventListener('resize', () => {
      window.requestAnimationFrame(updateLayout);
    });

    updateLayout();
  };

  if (document.readyState === 'complete' || document.readyState === 'interactive') {
    initCarousel();
  } else {
    document.addEventListener('DOMContentLoaded', initCarousel);
  }
</script>