---
const { quote, author, role } = Astro.props;
---

<section
    class="rounded-3xl border border-slate-200 bg-gradient-to-br from-cyan-50 via-white to-white p-8 text-left shadow-xl shadow-slate-200/60"
    aria-labelledby="testimonial-heading"
    data-reveal="scale"
>
    <div class="flex items-center gap-4">
        <div class="h-12 w-12 rounded-full bg-cyan-100" aria-hidden="true">
        </div>
        <div>
            <h2
                id="testimonial-heading"
                class="text-lg font-semibold text-slate-900"
            >
                {author}
            </h2>
            {role && <p class="text-sm text-slate-500">{role}</p>}
        </div>
    </div>
    <p class="mt-6 text-lg text-slate-700 italic">“{quote}”</p>
</section>
