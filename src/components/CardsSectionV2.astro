---

const steps = [
  {
    id: 'eligibility',
    badge: 'Étape 1',
    emoji: '📝',
    title: 'Vérifiez votre éligibilité',
    description: 'Remplissez notre formulaire guidé et découvrez en 2 minutes si vous pouvez bénéficier des aides.'
  },
  {
    id: 'guidance',
    badge: 'Étape 2',
    emoji: '👥',
    title: 'Accompagnement personnalisé',
    description: 'Un conseiller dédié analyse votre situation, sélectionne les dispositifs adaptés et vous accompagne.'
  },
  {
    id: 'works',
    badge: 'Étape 3',
    emoji: '🏠',
    title: 'Réalisation des travaux',
    description: 'Nos artisans certifiés pilotent le chantier, assurent la conformité et vous livrent un résultat clé en main.'
  }
];
---

<section class=" bg-[rgba(255,255,255,0.7)] flex flex-col items-center gap-[4vh] text-center py-[100px] bg-[url(../assets/main/home2_q99.avif)] bg-cover bg-no-repeat bg-center">
  <div class="w-full max-w-[1200px] px-4 sm:px-6">
    <div class="space-y-3 mb-10">
      <p class="text-sm font-semibold uppercase tracking-[0.25em] text-slate-500">Comment ça marche</p>
      <h2 class="text-3xl sm:text-4xl font-bold text-slate-900">Votre parcours en trois étapes</h2>
      <p class="text-base sm:text-lg text-slate-600 max-w-2xl mx-auto">
        Nous simplifions tout le processus, de l’éligibilité au suivi des travaux, avec un interlocuteur unique.
      </p>
    </div>

    <div class="grid gap-6 lg:gap-8 place-items-center md:grid-cols-2 lg:grid-cols-3 max-w-[1400px] lg:justify-items-center">
      {steps.map((step, index) => (
        <article
          class={`group relative flex flex-col bg-white/90 max-w-[300px] rounded-lg border border-white/60 p-6 text-left 
            shadow-[0_25px_60px_-30px_rgba(15,23,42,0.45)] 
            transition 
            hover:shadow-[0_35px_80px_-35px_rgba(15,23,42,0.55)] slide ${
                index === 0 ? 'slideRight' :
                index === steps.length - 1 ? 'slideLeft' :
                ''
            }`
        }
        >
            <div class="absolute -top-3 left-6 inline-flex items-center rounded-full bg-[#0a3d85] px-3 py-1 text-xs font-semibold uppercase tracking-wide text-white shadow">
                {step.badge}
            </div>

            <div class="my-12 mx-auto inline-flex h-14 w-14 items-center justify-center rounded-2xl text-7xl text-white shadow-lg">
                {step.emoji}
            </div>

            <h2 class="text-xl  text-slate-900 text-center">{step.title}</h2>
            <p class="mt-3 text-base text-slate-600 leading-relaxed text-justify">{step.description}</p>

          {/* <div class="mt-auto pt-5 text-sm font-semibold text-[#0a7cff] flex items-center gap-2">
            {index === steps.length - 1 ? 'Travaux supervisés' : 'On s’occupe de tout'}
            <span aria-hidden="true" class="transition group-hover:translate-x-1">→</span>
          </div> */}
        </article>
      ))}
    </div>
  </div>
</section>

