---
import FormBackground from "../assets/main/banner2.png";
import CheckIcon from "../assets/main/check-sq-1.svg";

const checklist = [
  "Recevez jusqu'à 11 500€ d'aides en 72h",
  "Jusqu'à 80% d'économies sur votre facture",
  "25% de plus-value sur votre maison",
  "Simulez vos aides 2025 ou le coût des travaux",
];


---

<section class="relative flex mx-auto w-full lg:h-[75vh]">
    <div class="flex h-full w-full flex-col-reverse gap-10 lg:flex-row lg:items-stretch ">
      <!-- Colonne texte -->
      <div class="flex flex-col justify-center w-full lg:w-9/20 py-16 ps-[7.5%]">
        <h1 class="mt-3 text-3xl font-extrabold text-slate-900 sm:text-4xl">
            <span class="block">Simulateur pompe à chaleur</span>
            <span class="mt-1 block bg-gradient-to-r from-[#0A008A] to-[hsl(233,89%,71%)] bg-clip-text text-transparent font-bold [-webkit-text-fill-color:transparent]">
            Chauffez et économisez
            </span>
        </h1>
        <p class="mt-2 text-base font-medium italic text-slate-600">
        Testez en 3 clics
        </p>

        <ul class="mt-6 flex flex-col gap-4 text-base text-slate-600">
          {checklist.map((item) => (
            <li class="flex items-center gap-3">
              {/* <span class="mt-1 inline-flex h-6 w-6 items-center justify-center rounded-md bg-emerald-500 text-white"> */}
            <span class="mt-1 inline-flex h-6 w-6 items-center justify-center rounded-md bg-white text-green">
                {/* <svg class="h-4 w-4" viewBox="0 0 16 16" fill="none">
                  <path d="M6.1 11.2 3.3 8.4l1.1-1.1 1.7 1.7 4.5-4.6 1.1 1.1-5.6 5.7z" fill="currentColor" />
                </svg> */}
                {/* <img src={CheckIcon} alt="" class="h-4 w-4" aria-hidden="true" /> */}
                <CheckIcon class="h-14 w-14 text-emerald-500" aria-hidden="true" />
              </span>
              <span>{item}</span>
            </li>
          ))}
        </ul>

        <div class="mt-8">
          <!-- <a
            href="#simulateur"
            class="inline-flex w-full items-center justify-center rounded-lg bg-emerald-500 px-6 py-3 text-base font-semibold text-white shadow-lg shadow-emerald-500/30 transition hover:bg-emerald-600 focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-400 md:w-auto"
          >
            Calculer mes aides financières
          </a> -->
            <a
                href="#simulateur"
                class="btn btn-success btn--glow mt-8 w-full md:w-auto"
                >
                Calculer mes aides financières
            </a>
        </div>
      </div>

      <!-- Colonne formulaire (placeholder) -->
      <div class="relative flex w-full  lg:w-11/20  py-16">

        <!-- Image de fond pour la carte formulaire -->
        <div
            class="absolute inset-0 hidden bg-cover bg-center lg:block [clip-path:polygon(14%_0%,100%_0%,100%_100%,0%_100%)]"
            style={`background-image: url(${FormBackground.src});`}
            aria-hidden="true"
        ></div>


        <!-- Carte formulaire -->
        <div class="relative mx-auto max-w-md rounded-3xl bg-white p-0 shadow-[0_30px_60px_-20px_rgba(10,63,149,0.35)]">
          <div class="rounded-t-3xl w-full bg-blue-1 px-6 py-4 text-center text-white">
            <p class="text-lg font-semibold">Calculez le montant de vos aides 2025</p>
            <p class="mt-1 text-xs uppercase tracking-[0.35em] text-sky-100">
              Anah · CEE · MPR · Éco-PTZ
            </p>
          </div>

          <div class="mt-6 p-6">
            <div class="rounded-2xl border border-slate-200 bg-slate-50 p-6 text-center">
            <p class="text-sm font-medium uppercase tracking-[0.25em] text-slate-500">
              Formulaire à venir
            </p>
            <p class="mt-2 text-base text-slate-600">
              Cette zone accueillera votre simulateur interactif.
            </p>
            </div>
          </div>
        </div>
      </div>
    </div>
</section>


