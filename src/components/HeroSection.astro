---
import FormBackground from "../assets/main/banner2.png";
import CheckIcon from "../assets/main/check-sq-1.svg";
import EligibilityForm from "./form/EligibilityForm";
import HeroBadges from "./HeroBadges.astro";

const checklist = [
  "Recevez jusqu'à 11 500€ d'aides en 72h",
  "Jusqu'à 80% d'économies sur votre facture",
  "25% de plus-value sur votre maison",
  "Simulez vos aides 2025 ou le coût des travaux",
];

---

<section class="relative flex mx-auto w-full lg:h-fit">

    <div class="flex h-full w-full flex-col lg:flex-row-reverse lg:items-stretch ">

      <!-- Version mobile : visible jusqu’à lg -->
      <div class="flex flex-col items-center gap-0 w-[90%] max-w-lg my-8 mx-auto lg:hidden">
        <h1 class="text-xl font-extrabold text-slate-900 sm:text-4xl text-center">
          <span class="block leading-[28px]">Simulateur pompe à chaleur</span>
          <span class="block bg-gradient-to-r from-[#0A008A] to-[hsl(233,89%,71%)] bg-clip-text text-transparent font-bold [-webkit-text-fill-color:transparent]">
            Chauffez et économisez
          </span>
        </h1>
        <p class="text-base font-medium italic text-slate-600">Testez en 3 clics</p>
        <!-- <a href="#simulateur" class="btn btn-success btn--glow w-full md:w-auto">
          Calculer mes aides financières
        </a> -->
        <div class=" flex flex-col items-center gap-1 lg:hidden">
          <svg class=" mt-4 h-7 w-7 text-slate-600 arrow-bounce" xmlns="http://www.w3.org/2000/svg" 
          viewBox="240 -720 480 560"  fill="#000000">
          <path d="M480-200 240-440l56-56 184 183 184-183 56 56-240 240Zm0-240L240-680l56-56 184 183 184-183 56 56-240 240Z"></path>
        </svg>
        </div>
      </div>

      <!-- Colonne formulaire (placeholder) -->
      <div class="relative flex w-full  lg:w-11/20  lg:py-6">

        <!-- Image de fond pour la carte formulaire -->
        <div
            class="absolute inset-0 hidden bg-cover bg-center lg:block [clip-path:polygon(14%_0%,100%_0%,100%_100%,0%_100%)]"
            style={`background-image: url(${FormBackground.src});`}
            aria-hidden="true"
        ></div>

        <!-- Carte formulaire -->
        <div class="relative z-10 mx-auto w-[92.5%] lg:w-full max-w-lg" id="eligibility-form-wrapper">
            <EligibilityForm client:load/>
        </div>
      </div>

      <!-- Colonne texte -->
      <!-- Version desktop : masquée avant lg -->
      <!-- <div class="flex flex-col justify-center w-full max-w-lg mx-auto lg:mx-0 lg:w-9/20 py-16 px-[7.5%] sm:px-0 lg:px-[7.5%] lg:ps-[7.5%]"> -->
      <div class="flex flex-col justify-center w-full max-w-lg lg:max-w-none mx-auto lg:mx-0 lg:w-9/20 py-16 px-[7.5%] sm:px-0 lg:px-[7.5%] lg:ps-[7.5%]">
        <h1 class="hidden lg:inline mt-3 text-3xl font-extrabold text-slate-900 sm:text-3xl">
            <span class="block ">Simulateur pompe à chaleur</span>
            <span class="mt-1 block bg-gradient-to-r from-[#0A008A] to-[hsl(233,89%,71%)] bg-clip-text text-transparent font-bold [-webkit-text-fill-color:transparent]">
            Chauffez et économisez
            </span>
        </h1>
        <p class="hidden sm:block mt-2 text-base font-medium italic text-slate-600">
        Testez en 3 clics
        </p>

        <ul class="mt-6 flex flex-col gap-4 text-base text-slate-600">
          {checklist.map((item) => (
            <li class="flex items-center gap-3">
            <span class="mt-1 inline-flex h-6 w-6 items-center justify-center rounded-md bg-white text-green">
                <CheckIcon class="h-14 w-14 text-emerald-500" aria-hidden="true" />
              </span>
              <span>{item}</span>
            </li>
          ))}
        </ul>

        <div class="mt-8">
          <!-- <a
            href="#simulateur"
            class="inline-flex w-full items-center justify-center rounded-lg bg-emerald-500 px-6 py-3 text-base font-semibold text-white shadow-lg shadow-emerald-500/30 transition hover:bg-emerald-600 focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-400 md:w-auto"
          >
            Calculer mes aides financières
          </a> -->
            <a
                href="#simulateur"
                class="hidden sm:block btn btn-success btn--glow mt-8 py-4 w-fit max-w-fit md:w-auto rounded-[0.5rem]"
                >
                Calculer mes aides financières
            </a>
        </div>
      </div>

    </div>
</section>
    <HeroBadges />



<style>
  @keyframes arrow-bounce {
    0%, 100% { transform: translateY(0); opacity: 0.75; }
    50%      { transform: translateY(6px); opacity: 1; }
  }

  .arrow-bounce {
    animation: arrow-bounce 1.6s ease-in-out infinite;
  }

  .arrow-bounce.delay-200 {
    animation-delay: 0.2s;
  }
</style>