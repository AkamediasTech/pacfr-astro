---
import FadeStyles from "../styles/FadeStyles.astro";

---

<section class="stats bg-[#22234A] w-full h-[288px] flex justify-center items-center">
    <div class="stats-container fade-text fade-in w-[960px] flex flex-row justify-between items-center p-6 text-white">
            <div class="flex flex-col justify-center items-center gap-4">
                <h3 class="font-sans text-8xl font-[100] text-white text-center m-0" data-value="10">10</h3>
                <p class="font-[100] text-2xl text-white text-center m-0">Ans de Garantie</p>
            </div>
            <div class="flex flex-col justify-center items-center gap-4">
                <h3 class="font-sans text-8xl font-[100] text-white text-center m-0" data-value="30%">30%</h3>
                <p class="font-[100] text-2xl text-white text-center m-0">De plus value sur votre bien</p>
            </div>
            <div class="flex flex-col justify-center items-center gap-4">
                <h3 class="font-sans text-8xl font-[100] text-white text-center m-0" data-value="80%">80%</h3>
                <p class="font-[100] text-2xl text-white text-center m-0">D'économie</p>
            </div>
        </div>
</section>

<FadeStyles />