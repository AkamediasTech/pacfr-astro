---
import FadeStyles from "../styles/FadeStyles.astro";

const stats = [
  { value: '10', label: 'Ans de Garantie' },
  { value: '30%', label: 'De plus value sur votre bien' },
  { value: '80%', label: "D'économie" },
];
---

<FadeStyles />


<section class="stats bg-[#22234A] w-full py-12 sm:py-16">
  <div class="stats-container fade-text fade-in mx-auto flex w-full max-w-6xl flex-col gap-8 px-6 text-white sm:flex-row  sm:justify-between">
    {stats.map((stat) => (
      <article class="flex basis-full flex-col items-center gap-4 text-center sm:basis-1/3">
        <div class="flex min-w-[160px] flex-col items-center justify-center">
          <h3 class="font-sans text-8xl font-[100] text-white text-center m-0 tabular-nums" data-value={stat.value}>
            {stat.value}
          </h3>
        </div>
        <p class="font-[100] text-2xl text-white text-center m-0">{stat.label}</p>
      </article>
    ))}
  </div>
</section>