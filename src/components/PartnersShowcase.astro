---

import type { ImageMetadata } from "astro/dist";

type PartnerItem = {
  name: string;
  logo: ImageMetadata | string;
  href?: string;
  width?: number;
  height?: number;
};

interface PartnerShowcaseProps {
  eyebrow?: string;
  heading: string;
  highlight?: string;
  partners: PartnerItem[];
  backgroundClass?: string;
  borderClass?: string;
}

const {
  eyebrow = 'Nos partenaires',
  heading = 'Nos Partenaires',
  highlight = '',
  partners = [],
  backgroundClass = 'bg-[#1c1f4d]',
  borderClass = 'border-slate-400/50',
} = Astro.props as PartnerShowcaseProps;

const headingId = 'partner-showcase-heading';
---

<section
  class={`w-full ${backgroundClass} py-12 px-6`}
  aria-labelledby={headingId}
>
  <div class="mx-auto flex max-w-6xl flex-col gap-6">
    <header>
      {eyebrow && (
        <p class="text-sm font-semibold uppercase tracking-[0.3em] text-slate-300">
          {eyebrow}
        </p>
      )}
      <h2
        id={headingId}
        class="mt-2 text-3xl font-semibold text-white sm:text-4xl"
      >
        {heading.replace(highlight, '')}
        {highlight && (
          <span class="text-[#0a7cff]">
            {` ${highlight}`}
          </span>
        )}
      </h2>
        <div class="relative mt-3 h-px w-full text-transparent" role="presentation">
    <span class={`absolute left-0 top-0 h-px w-1/2 border-t ${borderClass}`}></span>
  </div>
    </header>

    <div class="relative pb-6">
        <div class={`grid gap-12 sm:grid-cols-2 lg:grid-cols-4`}>
        {partners.map((partner) => {
            const figure = (
            <figure class="flex h-full items-center justify-center rounded-xl bg-white p-6 shadow-lg focus-within:ring-2 focus-within:ring-[#0a7cff]/60">
                <img
                src={typeof partner.logo === 'string' ? partner.logo : partner.logo.src}
                alt={`Logo ${partner.name}`}
                width={partner.width ?? (typeof partner.logo === 'string' ? 200 : partner.logo.width)}
                height={partner.height ?? (typeof partner.logo === 'string' ? 120 : partner.logo.height)}
                class="h-auto max-h-24 w-full object-contain"
                loading="lazy"
                decoding="async"
                />
                <figcaption class="sr-only">{partner.name}</figcaption>
            </figure>
            );

            return partner.href ? (
            <a
                id={`${partner.name}-link`}
                href={partner.href}
                class="group block focus-visible:outline focus-visible:outline-offset-2 focus-visible:outline-white"
                aria-label={`Découvrir ${partner.name}`}
            >
                {figure}
            </a>
            ) : (
            <div 
            id={`${partner.name}-logo-link`}
            >{figure}</div>
            );
        })}
        </div>

        <span
            aria-hidden="true"
            class={`absolute bottom-0 right-0 block h-px w-1/2 border-b ${borderClass}`}
        >
        </span>
    </div>

  </div>
</section>