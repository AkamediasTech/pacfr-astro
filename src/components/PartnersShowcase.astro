---
import type { ImageMetadata } from 'astro/dist';

type PartnerItem = {
  name: string;
  logo: ImageMetadata | string;
  href?: string;
  width?: number;
  height?: number;
};

interface PartnerShowcaseProps {
  eyebrow?: string;
  heading?: string;
  highlight?: string;
  partners?: PartnerItem[];
  backgroundClass?: string;
  borderColor?: string;
}

const {
//   eyebrow = 'Nos partenaires',
  eyebrow = undefined,
  heading = 'Nos Partenaires',
  highlight = 'Partenaires',
  partners = [],
  backgroundClass = 'bg-[#1c1f4d]',
  borderColor = 'rgba(255,255,255,0.4)',
} = Astro.props as PartnerShowcaseProps;

const headingId = 'partners-showcase-heading';
---

<section
  class={`partners-showcase w-full ${backgroundClass} py-12 px-6`}
  aria-labelledby={headingId}
  data-partners-root
>
  <div class="mx-auto flex max-w-7xl flex-col gap-8">
    <header class="relative">
      {eyebrow && (
        <p class="text-sm font-semibold uppercase tracking-[0.3em] text-slate-300">
          {eyebrow}
        </p>
      )}
      <h2 id={headingId} class="mt-2 text-3xl font-semibold text-white sm:text-4xl">
        {heading.replace(highlight, '').trim()}
        {highlight && <span class="text-[#0a7cff]">{` ${highlight}`}</span>}
      </h2>
      <span aria-hidden="true" class="partners-bar partners-bar--top"></span>
    </header>

    <div class="relative pb-6">
      <div class="partners-grid grid gap-16 sm:grid-cols-2 lg:grid-cols-4" data-partners-grid>
        {partners.map((partner) => {
          const figure = (
            <figure class="partner-card">
              <img
                src={typeof partner.logo === 'string' ? partner.logo : partner.logo.src}
                alt={`Logo ${partner.name}`}
                width={
                  partner.width ??
                  (typeof partner.logo === 'string' ? 200 : partner.logo.width)
                }
                height={
                  partner.height ??
                  (typeof partner.logo === 'string' ? 120 : partner.logo.height)
                }
                class="h-auto max-h-24 w-full object-contain"
                loading="lazy"
                decoding="async"
              />
              <figcaption class="sr-only">{partner.name}</figcaption>
            </figure>
          );

          return partner.href ? (
            <a
              href={partner.href}
              class="group block focus-visible:outlinefocus-visible:outline-offset-2 focus-visible:outline-white"
              aria-label={`Découvrir ${partner.name}`}
            >
              {figure}
            </a>
          ) : (
            <div 
            >{figure}</div>
          );
        })}
      </div>

      <span aria-hidden="true" class="partners-bar partners-bar--bottom"></span>
    </div>
  </div>
</section>

<style>
  .partners-showcase {
    --partners-segment: 0px;
    --partners-border-color: rgba(255, 255, 255, 0.4);
  }
  .partners-bar {
    display: block;
    height: 1px;
    width: min(var(--partners-segment), 100%);
    border-top: 1px solid var(--partners-border-color);
  }
  .partners-bar--top {
    margin-top: 1rem;
  }
  .partners-bar--bottom {
    position: absolute;
    bottom: 0;
    right: 0;
    border-top: 0;
    border-bottom: 1px solid var(--partners-border-color);
  }
  .partner-card {
    display: flex;
    height: 100%;
    align-items: center;
    justify-content: center;
    /* border-radius: 0.75rem; */
    border-radius: 0.25rem;
    background-color: #fff;
    padding: 1.5rem;
    box-shadow: 0 18px 45px rgba(12, 15, 45, 0.3);
  }
</style>

<script is:inline>
  (() => {
    const root = document.querySelector('[data-partners-root]');
    if (!root) return;

    const grid = root.querySelector('[data-partners-grid]');
    const cards = grid?.querySelectorAll('[data-partner-card], .partner-card') ?? [];
    if (!grid || cards.length === 0) return;

    const computeSegment = () => {
      const styles = getComputedStyle(grid);
      const gap = parseFloat(styles.columnGap || styles.gap) || 0;
      const widthA = cards[0]?.getBoundingClientRect().width ?? 0;
      const widthB = cards[1]?.getBoundingClientRect().width ?? widthA;
      const segment = widthA + widthB + gap * 2;
      root.style.setProperty('--partners-segment', `${segment}px`);
      root.style.setProperty('--partners-border-color', styles.getPropertyValue('--partners-border-color') || '${borderColor}');
    };

    computeSegment();
    window.addEventListener('resize', () => window.requestAnimationFrame(computeSegment));
  })();
</script>