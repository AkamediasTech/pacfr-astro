---
import { Image } from 'astro:assets';
import auroraPhoto from '../assets/case-photos/aurora.png';
import orionPhoto from '../assets/case-photos/orion.png';
import zenithPhoto from '../assets/case-photos/zenith.png';

const photoCases = [
  {
    title: 'Programme Aurora',
    description: 'Brand content, habillage événementiel et déclinaisons print & social pour une fintech européenne.',
    result: 'Temps de session moyen +54 %, trafic organique +32 % en 6 mois.',
    image: auroraPhoto,
    alt: 'Composition colorée du programme Aurora',
    reveal: 'slide-left',
  },
  {
    title: 'Orion Learning',
    description: 'Lancement d’une plateforme e-learning avec shooting photo, motion et onboarding gamifié.',
    result: 'Taux de complétion des parcours x1.8 et churn réduit de 23 %.',
    image: orionPhoto,
    alt: 'Palette violette et bleu pour Orion Learning',
    reveal: 'fade-up',
  },
  {
    title: 'Zenith Labs',
    description: 'Identité produit premium, kit UI et assets publicitaires pour une suite SaaS B2B.',
    result: 'Pipeline marketing qualifié +61 % et score CSAT à 4.7 / 5.',
    image: zenithPhoto,
    alt: 'Visuel abstrait dégradé pour Zenith Labs',
    reveal: 'slide-right',
  },
];
---
<section id="visual-work" class="flex flex-col gap-10" aria-labelledby="visual-heading">
  <div class="max-w-2xl">
    <p class="text-sm font-semibold uppercase tracking-[0.3em] text-cyan-600">Visuels</p>
    <h2 id="visual-heading" class="mt-2 text-3xl font-bold text-slate-900 md:text-4xl">Création d’univers captivants</h2>
    <p class="mt-3 text-base text-slate-600">
      Chaque image est servie en AVIF/WebP optimisés via `astro:assets`, avec des dimensions adaptées à l’affichage pour limiter le temps de chargement.
    </p>
  </div>

  <div class="grid gap-8 lg:grid-cols-3">
    {photoCases.map((item, index) => (
      <article
        class="rounded-3xl border border-slate-200 bg-white p-6 shadow-xl shadow-slate-200/70 transition hover:border-cyan-500/60"
        data-reveal={item.reveal}
        data-reveal-delay={index ? String(index * 140) : undefined}
      >
        <div class="overflow-hidden rounded-2xl border border-slate-100 bg-slate-100">
          <Image
            src={item.image}
            alt={item.alt}
            widths={[240, 320, 420, 480]}
            format="avif"
            sizes="(min-width: 1280px) 24vw, (min-width: 768px) 40vw, 100vw"
            quality={70}
            loading="lazy"
            decoding="async"
            fit="cover"
            class="aspect-[3/2] w-full object-cover"
          />
        </div>
        <div class="mt-6 flex flex-col gap-3">
          <h3 class="text-xl font-semibold text-slate-900">{item.title}</h3>
          <p class="text-sm leading-6 text-slate-600">{item.description}</p>
          <p class="text-sm font-semibold text-cyan-600">{item.result}</p>
        </div>
      </article>
    ))}
  </div>
</section>
