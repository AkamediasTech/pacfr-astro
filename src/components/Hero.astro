---
const {
  eyebrow,
  title,
  description,
  primaryCta,
  secondaryCta,
} = Astro.props;
---
<section class="mx-auto flex w-full max-w-3xl flex-col items-center gap-6 text-center" aria-labelledby="hero-heading">
  {eyebrow && (
    <p class="text-sm font-semibold uppercase tracking-[0.3em] text-cyan-300/80">
      {eyebrow}
    </p>
  )}
  <h1 id="hero-heading" class="text-4xl font-bold tracking-tight text-white md:text-6xl">
    {title}
  </h1>
  <p class="max-w-2xl text-lg text-white/70 md:text-xl">
    {description}
  </p>
  <div class="flex flex-col gap-3 sm:flex-row">
    <a href={primaryCta.href} class="btn btn-primary btn--glow">
      {primaryCta.label}
    </a>
    {secondaryCta && (
      <a href={secondaryCta.href} class="btn btn-ghost">
        {secondaryCta.label}
      </a>
    )}
  </div>
</section>
