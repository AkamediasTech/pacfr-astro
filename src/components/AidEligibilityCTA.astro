---

type CTAMessageConfig = {
  paragraphText: string;
  buttonText: string;
}

interface EligibilityCTAProps {
  config?: CTAMessageConfig;
}

const defaultConfig: CTAMessageConfig = {
  paragraphText: "Êtes-vous éligible ? Découvrez le montant de vos aides !",
  buttonText: "Simuler mes aides",
}

const { config = defaultConfig } = Astro.props as EligibilityCTAProps;

const resolvedConfig = {
  ...defaultConfig,
  ...config,
}

const buttonId = `cta-scroll-${Math.random().toString(36).slice(2, 8)}`;

---

<section class="bg-[#0a3d85] py-6 ">
  <div class="mx-auto w-full flex max-w-xs sm:max-w-6xl flex-col items-center gap-6  px-4 text-white lg:flex-row sm:justify-center overflow-x-hidden">
    <p class="font-sans text-center  text-xl sm:text-2xl font-light sm:text-left">
      <!-- Êtes-vous éligible ? Découvrez le montant de vos aides ! -->
      {resolvedConfig.paragraphText}
    </p>
    <button type="button" id={buttonId} data-scroll-to-form-target="eligibility-form-wrapper" class="btn btn-success btn--glow w-full md:w-auto bg-[#0a7cff] rounded-[4px] shadow-none cursor-pointer font-light text-xl sm:text-2xl py-2.5">
      <!-- Simuler mes aides -->
      {resolvedConfig.buttonText}
    </button>
  </div>
</section>
