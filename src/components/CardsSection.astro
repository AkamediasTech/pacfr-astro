---
const steps = [
    {
        id: "eligibility",
        badge: "Étape 1",
        emoji: "📝",
        title: "Vérifiez votre éligibilité",
        description:
            "Remplissez notre formulaire guidé et découvrez en 2 minutes si vous pouvez bénéficier des aides.",
    },
    {
        id: "guidance",
        badge: "Étape 2",
        emoji: "👥",
        title: "Accompagnement personnalisé",
        description:
            "Un conseiller dédié analyse votre situation, sélectionne les dispositifs adaptés et vous accompagne.",
    },
    {
        id: "works",
        badge: "Étape 3",
        emoji: "🏠",
        title: "Réalisation des travaux",
        description:
            "Nos artisans certifiés pilotent le chantier, assurent la conformité et vous livrent un résultat clé en main.",
    },
];
---

<section
    class="flex flex-col items-center gap-[4vh] bg-[rgba(255,255,255,0.7)] bg-[url(../assets/main/home2_q99.avif)] bg-cover bg-center bg-no-repeat py-[100px] text-center"
>
    <div class="w-full max-w-[1200px] px-4 sm:px-6">
        <div class="mb-10 space-y-3">
            <p
                class="text-sm font-semibold tracking-[0.25em] text-slate-500 uppercase"
            >
                Comment ça marche
            </p>
            <h2 class="text-3xl font-bold text-slate-900 sm:text-4xl">
                Votre parcours en trois étapes
            </h2>
            <p class="mx-auto max-w-2xl text-base text-slate-600 sm:text-lg">
                Nous simplifions tout le processus, de l’éligibilité au suivi
                des travaux, avec un interlocuteur unique.
            </p>
        </div>

        <div
            class="flex max-w-[1400px] flex-wrap justify-center gap-6 md:gap-8 lg:gap-12"
        >
            {
                steps.map((step, index) => (
                    <article
                        class={`group slide relative flex max-w-[300px] flex-col rounded-lg border border-white/60 bg-white/90 p-6 text-left shadow-[0_25px_60px_-30px_rgba(15,23,42,0.45)] transition hover:shadow-[0_35px_80px_-35px_rgba(15,23,42,0.55)] ${
                            index === 0
                                ? "slideReveal slideFromLeft"
                                : index === steps.length - 1
                                  ? "slideReveal slideFromRight"
                                  : ""
                        }`}
                        style={`
              --slide-duration: 800ms;
              --slide-distance: 50px;
            `}
                    >
                        <div class="absolute -top-3 left-6 inline-flex items-center rounded-full bg-[#0a3d85] px-3 py-1 text-xs font-semibold tracking-wide text-white uppercase shadow">
                            {step.badge}
                        </div>

                        <div class="mx-auto my-12 inline-flex h-14 w-14 items-center justify-center rounded-2xl text-7xl text-white shadow-lg">
                            {step.emoji}
                        </div>

                        <h2 class="text-center text-xl text-slate-900">
                            {step.title}
                        </h2>
                        <p class="mt-3 text-justify text-base leading-relaxed text-slate-600">
                            {step.description}
                        </p>

                        {/* <div class="mt-auto pt-5 text-sm font-semibold text-[#0a7cff] flex items-center gap-2">
                {index === steps.length - 1 ? 'Travaux supervisés' : 'On s’occupe de tout'}
                <span aria-hidden="true" class="transition group-hover:translate-x-1">→</span>
              </div> */}
                    </article>
                ))
            }
        </div>
    </div>
</section>
