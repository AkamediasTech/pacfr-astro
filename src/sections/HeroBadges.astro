<section class="bg-white w-full border-t-2 border-slate-200 py-4 lg:py-4">
  <div class="mx-auto flex max-w-4xl flex-nowrap items-center justify-center gap-6 lg:gap-12 px-6 h-[80px]">
     <Image
        src={badges[0].file}
        alt={badges[0].name}
        class="w-[58.5px] md:w-[78px] "
        format="webp"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
      <Image
        src={badges[1].file}
        alt={badges[1].name}
        class="w-[65.25px] md:w-[87px] "
        format="webp"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
      <Image
        src={badges[2].file}
        alt={badges[2].name}
        class="w-[54px] md:w-[72px] "
        format="webp"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
      <Image
        src={badges[3].file}
        alt={badges[3].name}
        class="w-[43px] md:w-[57px] "
        format="webp"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
  </div>
</section>

