---
import type { V1Props } from "./factory";

const props = Astro.props as V1Props;

const { eyebrow, title, highlight, secondTitle, secondHighlight } =
    props.heading;
const paragraphs = props.body;
const videoSrc = props.videoSrc;
---

<section
    class="w-full bg-white sm:px-10"
    aria-labelledby="aid-section-title"
    id="#aid-section"
>
    <div
        class="px-auto mx-auto flex w-full max-w-7xl flex-col gap-8 px-6 py-16 sm:px-10 lg:px-0"
    >
        <header>
            <p
                class="text-sm font-semibold tracking-[0.3em] text-[#0a7cff] uppercase"
            >
                {eyebrow}
            </p>
            <h2
                id="aid-section-title"
                class="fade-text fade-text-auto mt-2 text-3xl font-light text-slate-900 sm:text-[2rem]"
            >
                {title},
                <span class="font-semibold text-[#0a7cff]">{highlight}</span>
            </h2>
            <div
                class="mt-3 h-[0.12rem] w-[25%] rounded-full bg-[var(--color-bright-blue)]"
                role="presentation"
            >
            </div>
        </header>

        <div
            class="flex flex-col-reverse items-center gap-10 lg:flex-row-reverse lg:items-start"
        >
            <article
                class="slideReveal slideFromRight flex-1 space-y-5 text-lg leading-relaxed text-slate-700"
            >
                <div>
                    <h3 class="text-2xl font-normal text-slate-900">
                        {secondTitle}
                        <span class="highlight">{secondHighlight}</span>
                    </h3>
                    <div
                        class="mt-2 h-0.5 w-40 bg-[var(--color-bright-blue)]"
                        role="presentation"
                    >
                    </div>
                </div>

                <!-- <p class="text-justify">
          Le gouvernement met en place un programme pour aider les propriétaires, en particulier ceux chauffés au gaz ou au fioul,
          à passer à la pompe à chaleur air-eau grâce à des aides financières. Cette transition permet de réduire jusqu’à 70 % de la
          facture énergétique tout en limitant l’empreinte carbone.
        </p>
        <p class="text-justify">
          Le plus avantageux ? Les nouvelles subventions couvrent l’installation, évitant ainsi toute avance de frais pour les bénéficiaires.
          Notre équipe vous accompagne gratuitement pour estimer vos gains et sécuriser les primes avant le début des travaux.
        </p> -->

                {
                    paragraphs &&
                        paragraphs?.map((p, i) => {
                            return <p class="text-justify">{p}</p>;
                        })
                }
            </article>

            <div class="slideReveal slideFromLeft w-full max-w-[540px]">
                <div
                    class="aspect-video w-full overflow-hidden rounded-2xl shadow-2xl ring-1 ring-slate-200/60"
                >
                    <iframe
                        src={videoSrc}
                        title="Présentation des aides à la pompe à chaleur"
                        loading="lazy"
                        referrerpolicy="strict-origin-when-cross-origin"
                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                        allowfullscreen
                        class="h-full w-full"></iframe>
                </div>
            </div>
        </div>
    </div>
</section>
