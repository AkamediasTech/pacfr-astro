---
import { Image } from "astro:assets";
// import type { Logo } from "@content/header/types";
// import { getVisibilityClass } from "./factory";

// const { brandLogo, partnerLogos, bannerText } = Astro.props as {
//     brandLogo: Logo;
//     partnerLogos: Logo[];
//     bannerText: string;
// };

const { bannerText, brandLogo, partnerLogos } = Astro.props as {
    bannerText: string;
    brandLogo: {
        name: string;
        file: any;
        className: string;
    };
    partnerLogos: Array<{
        name: string;
        file: any;
        className: string;
        visibilityClass: string; // ← Déjà calculée !
    }>;
};
---

<header
    class="relative z-50 border-b border-slate-200 bg-white/90 backdrop-blur"
>
    <div class="bg-[#004081] px-[5%] text-white">
        <div
            class="md:text-md mx-auto w-full max-w-[90%] py-1 text-center text-xs tracking-wide italic sm:max-w-none sm:text-left lg:px-6 lg:text-lg"
        >
            {bannerText}
        </div>
    </div>

    <div
        class="mx-auto flex w-[95%] items-center justify-between gap-4 py-4 sm:w-[90%] sm:px-6 sm:py-2 md:flex-row"
    >
        <div>
            <a
                href="/"
                class="flex items-center gap-3 text-lg font-semibold tracking-tight text-slate-900"
            >
                <Image
                    src={brandLogo.file}
                    alt={brandLogo.name}
                    class={`h-12 w-auto object-contain ${brandLogo.className ?? ""}`}
                    loading="eager"
                    fetchpriority="high"
                    decoding="async"
                />
            </a>
        </div>

        <div class="flex items-center gap-4 md:gap-3">
            {
                partnerLogos.map((logo, _) => (
                    // <div
                    //     class={`${getVisibilityClass(p.visibleAbove ?? "desktop")} items-center justify-center bg-white px-2 sm:px-4 sm:py-2`}

                    // >
                    <div
                        class={`${logo.visibilityClass} items-center justify-center bg-white px-2 sm:px-4 sm:py-2`}
                    >
                        <Image
                            src={logo.file}
                            alt={logo.name}
                            class={`h-10 w-auto object-contain ${logo.className ?? ""}`}
                            loading="eager"
                            fetchpriority="high"
                            decoding="async"
                        />
                    </div>
                ))
            }
        </div>
    </div>
</header>
