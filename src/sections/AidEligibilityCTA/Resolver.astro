---
import { ContentByTheme } from "@/content/aidEligibilityCTA/content.v1";
import { resolveVariant } from "./factory";
import type { ContentVariant } from "@/content/aidEligibilityCTA/types";

const {
    theme = "pacfr",
    variant = "v1",
    contentVariant,
} = Astro.props as {
    theme?: "pacfr";
    variant?: string;
    contentVariant?: ContentVariant;
};

const themeContent = ContentByTheme[theme];
const content =
    contentVariant && themeContent.variants?.[contentVariant]
        ? themeContent.variants[contentVariant]
        : themeContent.default;

const { component: Component, propsFactory } = resolveVariant(variant);
const props = propsFactory(content);
---

<Component {...props} />
