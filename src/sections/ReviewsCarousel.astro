---
import { Image as AstroImage } from "astro:assets";

import GoogleProfile from "../assets/reviews/google-profile.webp";
import ArrowLeft from "../assets/reviews/arrow-left.png";
import ArrowRight from "../assets/reviews/arrow-right.png";
import ReviewShot1 from "../assets/reviews/review-1.png";
import ReviewShot2 from "../assets/reviews/review-2.png";
import ReviewShot3 from "../assets/reviews/review-3.png";
import ReviewShot4 from "../assets/reviews/review-4.png";
import ReviewShot5 from "../assets/reviews/review-5.png";
import ReviewShot6 from "../assets/reviews/review-6.png";

const slides = [
    { id: "review-1", image: ReviewShot1, alt: "Avis client 1" },
    { id: "review-2", image: ReviewShot2, alt: "Avis client 2" },
    { id: "review-3", image: ReviewShot3, alt: "Avis client 3" },
    { id: "review-4", image: ReviewShot4, alt: "Avis client 4" },
    { id: "review-5", image: ReviewShot5, alt: "Avis client 5" },
    { id: "review-6", image: ReviewShot6, alt: "Avis client 6" },
];

const carouselId = `reviews-carousel-${Math.random().toString(36).slice(2, 8)}`;
---

<section class="bg-white">
    <div class="bg-[#1D1F55] text-white">
        <div class="mx-auto max-w-[90%] py-6 text-start sm:px-6 sm:py-10">
            <p
                class="text-2xl font-semibold tracking-[0.0em] text-slate-50 uppercase sm:text-3xl"
            >
                Nos clients
            </p>
            <h2
                class="text-2xl font-semibold text-[#0a7cff] uppercase sm:text-3xl"
            >
                Parlent de nous
            </h2>
        </div>
    </div>

    <div
        class="mx-auto max-w-[95%] pt-10 pb-16 sm:max-w-[90%] lg:px-6 lg:py-24 lg:ps-0"
    >
        <div
            id={carouselId}
            data-visible-desktop="3"
            data-visible-tablet="2"
            data-visible-mobile="1"
            data-gap="24"
            class="fadeReveal fadeFromBottom"
            style="--fade-duration: 1000ms; --fade-easing: ease-out;"
        >
            <div
                class="flex flex-col gap-10 lg:flex-row lg:items-start lg:gap-6"
            >
                <aside
                    class="my-auto rounded-2xl bg-white px-5 py-5 lg:w-[280px]"
                >
                    <div
                        class="lg:justtify-start flex items-center justify-center gap-4"
                    >
                        <div
                            class="h-14 w-14 overflow-hidden rounded-full bg-slate-200"
                        >
                            <AstroImage
                                src={GoogleProfile}
                                alt="Profil Google"
                                class="h-full w-full object-cover"
                            />
                        </div>
                        <div>
                            <p class="text-sm text-slate-800">EnergieFrance</p>
                            <div class="flex items-center gap-2">
                                <span class="text-xl font-bold text-slate-900"
                                    >4.6</span
                                >
                                <!-- <span class="flex items-center text-amber-400">
                        {Array.from({ length: 5 }, (_, index) => (
                        // <svg class={`h-4 w-4 ${index < 4 ? 'fill-amber-400' : 'fill-slate-200'}`} viewBox="0 0 20 20">
                        //     <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.12 3.439a1 1 0 00.95.69h3.62c.969 0 1.371 1.24.588 1.81l-2.928 2.128a1 1 0 00-.364 1.118l1.12 3.438c.3.922-.755 1.688-1.54 1.118l-2.928-2.128a1 1 0 00-1.175 0L6.83 16.668c-.784.57-1.838-.196-1.539-1.118l1.12-3.438a1 1 0 00-.364-1.118L3.12 8.866c-.783-.57-.38-1.81.588-1.81h3.62a1 1 0 00.95-.69l1.12-3.439z" />
                        // </svg>
                        
                        ))}
                    </span> -->
                                <span
                                    class="flex ps-[6px] pr-[4px]"
                                    role="img"
                                    aria-label="4,6 étoiles"
                                >
                                    <span
                                        class="inline-block h-5 w-5 bg-[url(../assets/main/ic_star_rate_14.png)] bg-contain"
                                    ></span>
                                    <span
                                        class="inline-block h-5 w-5 bg-[url(../assets/main/ic_star_rate_14.png)] bg-contain"
                                    ></span>
                                    <span
                                        class="inline-block h-5 w-5 bg-[url(../assets/main/ic_star_rate_14.png)] bg-contain"
                                    ></span>
                                    <span
                                        class="inline-block h-5 w-5 bg-[url(../assets/main/ic_star_rate_14.png)] bg-contain"
                                    ></span>
                                    <span
                                        class="inline-block h-5 w-5 bg-[url(../assets/main/ic_star_rate_half_14.png)] bg-contain"
                                    ></span>
                                    <!-- <span class="inline-block w-5 h-5 bg-image:url(./assets/ic_star_rate_14.png) UpDOYb"></span> -->
                                </span>
                            </div>
                            <p class="text-xs text-slate-500">
                                Basé sur 39 avis
                            </p>
                            <p class="flex gap-0 tracking-normal">
                                <span class="m-0 p-0 pr-1">powered by </span>
                                <span
                                    class="m-0 p-0"
                                    style="color:#6186ec!important">G</span
                                >
                                <span
                                    class="m-0 p-0"
                                    style="color:#cd523f!important">o</span
                                >
                                <span
                                    class="m-0 p-0"
                                    style="color:#eabe43!important">o</span
                                >
                                <span
                                    class="m-0 p-0"
                                    style="color:#6186ec!important">g</span
                                >
                                <span
                                    class="m-0 p-0"
                                    style="color:#63a45d!important">l</span
                                >
                                <span
                                    class="m-0 p-0"
                                    style="color:#cd523f!important">e</span
                                >
                            </p>
                        </div>
                    </div>
                </aside>

                <div class="relative min-w-0 flex-1">
                    <div class="carousel-frame">
                        <button
                            type="button"
                            class="carousel-arrow"
                            data-prev
                            aria-label="Avis précédent"
                        >
                            <AstroImage
                                src={ArrowLeft}
                                alt="Précédent"
                                class="h-auto w-8 pl-2.5 font-bold"
                            />
                        </button>

                        <div class="carousel-window min-w-0" data-window>
                            <ul class="carousel-track" data-track>
                                {
                                    slides.map((slide) => (
                                        <li class="carousel-slide" data-slide>
                                            <div class="inline-block overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
                                                <AstroImage
                                                    src={slide.image}
                                                    alt={slide.alt}
                                                    class="h-full w-full object-cover"
                                                    loading="lazy"
                                                    decoding="async"
                                                />
                                            </div>
                                        </li>
                                    ))
                                }
                            </ul>
                        </div>

                        <button
                            type="button"
                            class="carousel-arrow"
                            data-next
                            aria-label="Avis suivant"
                        >
                            <AstroImage
                                src={ArrowRight}
                                alt="Suivant"
                                class="h-auto w-8 pr-2.5 font-bold"
                            />
                        </button>
                    </div>
                </div>
            </div>

            <div class="carousel-dots" data-dots></div>
        </div>
    </div>
</section>

<style>
    .carousel-frame {
        display: flex;
        align-items: center;
        gap: 1rem;
    }
    .carousel-window {
        flex: 1;
        min-width: 0;
        overflow: hidden;
    }
    .carousel-track {
        display: flex;
        gap: 0;
        transition: transform 0.5s ease;
        transform: translateX(0);
    }
    .carousel-slide {
        flex: 0 0 auto;
        margin-right: calc(var(--carousel-gap, 24px));
    }
    .carousel-slide:last-child {
        margin-right: 0;
    }
    .carousel-arrow {
        display: grid;
        place-items: center;
        height: 42px;
        width: 42px;
        border-radius: 9999px;
        background-color: #ffffff;
        box-shadow: 0 12px 30px -18px rgba(15, 23, 42, 0.4);
        /* border: 1px solid rgba(148, 163, 184, 0.35); */
        transition:
            background-color 0.2s ease,
            border-color 0.2s ease,
            transform 0.2s ease;
    }
    .carousel-arrow:hover {
        background-color: #f8fafc;
        border-color: rgba(148, 163, 184, 0.6);
        transform: translateY(-2px);
        cursor: pointer;
    }
    .carousel-arrow:active {
        transform: translateY(0);
    }
    .carousel-arrow:focus-visible {
        outline: 2px solid #1d1f55;
        outline-offset: 3px;
    }
    @media (max-width: 639px) {
        .carousel-frame {
            gap: 0.75rem;
        }
        .carousel-arrow {
            height: 36px;
            width: 36px;
        }
    }
    .carousel-dots {
        margin-top: 1.5rem;
        display: flex;
        justify-content: center;
        gap: 0.5rem;
    }
    :global(.carousel-dot) {
        width: 10px;
        height: 10px;
        border-radius: 9999px;
        background-color: #cbd5f5;
        transition:
            background-color 0.2s ease,
            transform 0.2s ease,
            box-shadow 0.2s ease;
        cursor: pointer;
    }
    :global(.carousel-dot.is-active) {
        background-color: #0a7cff;
        backdrop-filter: blur(4px);
        -webkit-backdrop-filter: blur(4px);
        box-shadow: 0 0 8px rgba(10, 124, 255, 0.5);
        transform: scale(1.3);
    }
</style>

<script is:inline define:vars={{ carouselId }}>
    (() => {
        const root = document.getElementById(carouselId);
        if (!root) return;

        const viewport = root.querySelector("[data-window]");
        const track = root.querySelector("[data-track]");
        const slides = Array.from(root.querySelectorAll("[data-slide]"));
        const prevBtn = root.querySelector("[data-prev]");
        const nextBtn = root.querySelector("[data-next]");
        const dotsContainer = root.querySelector("[data-dots]");
        if (!viewport || !track || slides.length === 0 || !dotsContainer)
            return;

        const gap = Number(root.dataset.gap) || 24;

        const parseVisible = () => {
            const width = window.innerWidth;
            if (width >= 1024) return Number(root.dataset.visibleDesktop) || 3;
            if (width >= 640) return Number(root.dataset.visibleTablet) || 2;
            return Number(root.dataset.visibleMobile) || 1;
        };

        let visible = parseVisible();
        let index = 0;
        let dots = [];

        const setSlideWidths = () => {
            const viewportWidth = viewport.clientWidth;
            const totalGap = gap * (visible - 1);
            const width = Math.max(0, (viewportWidth - totalGap) / visible);

            slides.forEach((slide) => {
                slide.style.width = `${width}px`;
                slide.style.marginRight = `${gap}px`;
            });
            slides[slides.length - 1].style.marginRight = "0px";
            track.style.setProperty("--carousel-gap", `${gap}px`);
        };

        const maxIndex = () => Math.max(0, slides.length - visible);

        const buildDots = () => {
            dotsContainer.innerHTML = "";
            const dotCount = maxIndex() + 1; // positions affichables
            dots = Array.from({ length: dotCount }, (_, pos) => {
                const dot = document.createElement("button");
                dot.type = "button";
                dot.classList.add("carousel-dot");
                dot.addEventListener("click", () => {
                    index = Math.min(pos, maxIndex());
                    render();
                });
                dotsContainer.appendChild(dot);
                return dot;
            });
        };

        const render = () => {
            visible = parseVisible();
            index = Math.max(0, Math.min(index, maxIndex()));

            setSlideWidths();

            const slideWidth = slides[0]?.getBoundingClientRect().width || 0;
            const offset = index * (slideWidth + gap);
            track.style.transform = `translateX(-${offset}px)`;

            dots.forEach((dot, i) => {
                dot.classList.toggle("is-active", i === index);
            });
        };

        const refresh = () => {
            const oldVisible = visible;
            visible = parseVisible();
            if (oldVisible !== visible || dots.length === 0) {
                buildDots();
            }
            render();
        };

        prevBtn?.addEventListener("click", () => {
            const max = maxIndex();
            index = index <= 0 ? max : index - 1;
            render();
        });

        nextBtn?.addEventListener("click", () => {
            const max = maxIndex();
            index = index >= max ? 0 : index + 1;
            render();
        });

        window.addEventListener("resize", () => {
            window.requestAnimationFrame(refresh);
        });

        buildDots();
        render();
    })();
</script>
