
<style define:vars is:global>
    .slide {
        opacity: 0;
        transform: translateX(0);
        transition: opacity 0.8s ease-out, transform 0.8s ease-out;
    }
    .slideLeft {
        transform: translateX(50px);
    }
    .slideRight {
        transform: translateX(-50px);
    }
    .slidevisible {
        opacity: 1;
        transform: translateX(0);
    }
</style>
