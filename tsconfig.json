{
    "extends": "astro/tsconfigs/base",
    "compilerOptions": {
        "baseUrl": ".",
        "jsx": "react-jsx",
        "jsxImportSource": "preact",
        "strict": true,
        "paths": {
            "@/*": ["src/*"],
            "@components/*": ["src/components/*"],
            "@sections/*": ["src/sections/*"],
            "@content/*": ["src/content/*"],
            "@landings/*": ["src/landings/*"],
            "@layouts/*": ["src/layouts/*"],
            "@assets/*": ["src/assets/*"]
        }
    }
}
